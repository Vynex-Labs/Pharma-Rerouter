# Copy to .env and fill. NEVER commit .env (see docs/security.md).
PORT=3000

# SAP S/4HANA Cloud OData. Leave blank to run in SIMULATED mode (data_source badge will say so).
SAP_MODE=SIMULATED            # SIMULATED | SAP_SANDBOX | LIVE_SAP
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
SAP_API_KEY=

# Language model provider. Leave blank to run with the deterministic MockProvider (NFR-003).
LLM_PROVIDER=mock             # mock | openai | anthropic | sap-ai-core
LLM_API_KEY=
LLM_MODEL=

# Deterministic seed for synthetic data generation (REQ-101).
SEED=20260907
